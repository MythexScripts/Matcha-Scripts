-- ---------------------------------------------------------------- helpers --
local U = {}

function U.clamp(v, a, b)
    if type(v) ~= "number" or v ~= v then return a end
    return math.max(a, math.min(b, v))
end
function U.lerp(a, b, t) return a + (b - a) * t end
function U.round(v) return math.floor(v + 0.5) end
function U.easeOut(t) local f = 1 - t; return 1 - f * f * f end
function U.easeIn(t) return t * t * t end
function U.trim(s) return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")) end
function U.cut(s, n)
    s = tostring(s or "")
    if #s <= n then return s end
    local e = n
    while e > 0 do
        local b = string.byte(s, e + 1)
        if not b or b < 128 or b >= 192 then break end
        e = e - 1
    end
    return string.sub(s, 1, e)
end
function U.prop(obj, name, fallback)
    if obj == nil then return fallback end
    local ok, value = pcall(function() return obj[name] end)
    if ok and value ~= nil then return value end
    return fallback
end
-- Jak U.prop, ale do właściwości, których build może nie mieć wcale
-- (np. Players.MaxPlayers) — pcall zamienia błąd odczytu na nil.
-- Mieszanie dwóch kolorów (t=0 -> a, t=1 -> b). Używane do rozjaśniania
-- przycisku po najechaniu i po włączeniu.
function U.mix(a, b, t)
    if type(a) ~= "userdata" or type(b) ~= "userdata" then return a end
    local ok, out = pcall(function()
        local f = U.clamp(tonumber(t) or 0, 0, 1)
        return Color3.fromRGB(
            (a.R * 255) * (1 - f) + (b.R * 255) * f,
            (a.G * 255) * (1 - f) + (b.G * 255) * f,
            (a.B * 255) * (1 - f) + (b.B * 255) * f)
    end)
    if ok and out then return out end
    return a
end
function U.soft(obj, name, fallback)
    if obj == nil then return fallback end
    local ok, value = pcall(function() return obj[name] end)
    if ok and value ~= nil then return value end
    return fallback
end
function U.call(obj, name, ...)
    if obj == nil then return nil end
    local args, count = { ... }, select("#", ...)
    local ok, value = pcall(function() return obj[name](obj, unpack(args, 1, count)) end)
    if ok then return value end
    return nil
end
function U.service(name)
    if type(game) ~= "userdata" and type(game) ~= "table" then return nil end
    return U.call(game, "GetService", name)
end
function U.two(n) return string.format("%02d", math.floor(n)) end

-- Estymata szerokości znaków dla fontu sans. Używana tylko gdy TextBounds nie
-- działa — normalnie szerokość mierzy sama Matcha.
local CHAR_W = {
    [" "] = 0.26, ["!"] = 0.28, ['"'] = 0.36, ["#"] = 0.55, ["$"] = 0.55,
    ["%"] = 0.86, ["&"] = 0.66, ["'"] = 0.20, ["("] = 0.33, [")"] = 0.33,
    ["*"] = 0.39, ["+"] = 0.58, [","] = 0.26, ["-"] = 0.33, ["."] = 0.26,
    ["/"] = 0.28, [":"] = 0.26, [";"] = 0.26, ["<"] = 0.58, ["="] = 0.58,
    [">"] = 0.58, ["?"] = 0.52, ["@"] = 0.92, ["["] = 0.32, ["\\"] = 0.28,
    ["]"] = 0.32, ["^"] = 0.46, ["_"] = 0.44, ["`"] = 0.30, ["{"] = 0.34,
    ["|"] = 0.26, ["}"] = 0.34, ["~"] = 0.58,
    ["0"] = 0.56, ["1"] = 0.32, ["2"] = 0.56, ["3"] = 0.56, ["4"] = 0.58,
    ["5"] = 0.56, ["6"] = 0.56, ["7"] = 0.52, ["8"] = 0.56, ["9"] = 0.56,
    ["A"] = 0.68, ["B"] = 0.66, ["C"] = 0.70, ["D"] = 0.72, ["E"] = 0.62,
    ["F"] = 0.58, ["G"] = 0.74, ["H"] = 0.74, ["I"] = 0.30, ["J"] = 0.44,
    ["K"] = 0.66, ["L"] = 0.58, ["M"] = 0.86, ["N"] = 0.74, ["O"] = 0.76,
    ["P"] = 0.62, ["Q"] = 0.76, ["R"] = 0.68, ["S"] = 0.62, ["T"] = 0.60,
    ["U"] = 0.72, ["V"] = 0.68, ["W"] = 0.94, ["X"] = 0.66, ["Y"] = 0.64,
    ["Z"] = 0.60,
    ["a"] = 0.54, ["b"] = 0.56, ["c"] = 0.50, ["d"] = 0.56, ["e"] = 0.54,
    ["f"] = 0.32, ["g"] = 0.56, ["h"] = 0.56, ["i"] = 0.24, ["j"] = 0.24,
    ["k"] = 0.52, ["l"] = 0.24, ["m"] = 0.84, ["n"] = 0.56, ["o"] = 0.56,
    ["p"] = 0.56, ["q"] = 0.56, ["r"] = 0.34, ["s"] = 0.48, ["t"] = 0.32,
    ["u"] = 0.56, ["v"] = 0.50, ["w"] = 0.74, ["x"] = 0.50, ["y"] = 0.50,
    ["z"] = 0.48,
}
function U.estimateWidth(s, size, bold)
    s = tostring(s or "")
    local total = 0
    for i = 1, #s do total = total + (CHAR_W[s:sub(i, i)] or 0.55) end
    local width = total * (size or 13) * (CONFIG.FontWidth or 1)
    if bold then width = width * (CONFIG.BoldWidth or 1.09) end
    return width
end

local MONTHS = { "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December" }
local WEEKDAYS = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }

-- Zegar lokalny. os.date nie jest w dokumentacji Matchy, więc jest sondowany
-- z pcall i ma jawną korektę CONFIG.ClockOffsetHours dla buildów na UTC.
function U.clock()
    if type(os) ~= "table" or type(os.date) ~= "function" then return nil end
    local ok, result = pcall(function()
        local offset = tonumber(CONFIG.ClockOffsetHours) or 0
        local d
        if offset ~= 0 then d = os.date("!*t") else d = os.date("*t") end
        if type(d) ~= "table" then return nil end
        local minutes = (d.hour or 0) * 60 + (d.min or 0) + math.floor(offset * 60 + 0.5)
        local dayShift = 0
        while minutes < 0 do minutes = minutes + 1440; dayShift = dayShift - 1 end
        while minutes >= 1440 do minutes = minutes - 1440; dayShift = dayShift + 1 end
        return {
            hour = math.floor(minutes / 60),
            min = minutes % 60,
            day = (d.day or 1) + dayShift,
            month = d.month or 1,
            year = d.year or 0,
            weekday = d.wday,
        }
    end)
    if ok and type(result) == "table" then return result end
    return nil
end

function U.formatUptime(seconds)
    seconds = math.max(0, math.floor(seconds or 0))
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if h > 0 then return tostring(h) .. "h " .. tostring(m) .. "m" end
    if m > 0 then return tostring(m) .. "m " .. tostring(s) .. "s" end
    return tostring(s) .. "s"
end

